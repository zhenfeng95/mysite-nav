# Public site origin used for canonical URLs, Open Graph, sitemap and robots.txt.
# Local development:
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Production:
# NUXT_PUBLIC_SITE_URL=https://nav.zhenvia.com

# Neon Postgres (Vercel Neon integration usually sets DATABASE_URL)
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Or via Nuxt runtimeConfig:
# NUXT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Admin (required for /admin and review APIs)
NUXT_ADMIN_PASSWORD=change-me
NUXT_ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
